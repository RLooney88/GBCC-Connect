# Firebase Configuration
# Copy this file to .env and fill in your Firebase project details

# Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Firebase Auth Domain
FIREBASE_AUTH_DOMAIN=your-auth-domain

# Firebase API Key
FIREBASE_API_KEY=your-api-key

# Firebase App ID
FIREBASE_APP_ID=your-app-id

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Measurement ID
FIREBASE_MEASUREMENT_ID=your-google-analytics-id

# Environment (development, staging, production)
ENVIRONMENT=development

# API Base URL
API_BASE_URL=https://your-api-url.com

# Enable Analytics (true/false)
ENABLE_ANALYTICS=true

# Enable Crashlytics (true/false)
ENABLE_CRASHLYTICS=true

# Enable Performance Monitoring (true/false)
ENABLE_PERFORMANCE=true 